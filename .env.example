# E2E test config for QA Browser Execution
E2E_ENV="staging"
E2E_BASE_URL_STAGING="https://staging.example.com"

# Format Kredensial Role:
# USER_<ROLE>_<IDENTIFIER>="username/email"
# PASS_<ROLE>_<IDENTIFIER>="password"
USER_OWNER_MAIN="user-owner@example.com"
PASS_OWNER_MAIN="your-password-here"
USER_CS_AGENT="cs-agent@example.com"
PASS_CS_AGENT="your-password-here"

# ==============================================================================
# DATABASE QA VALIDATION CONFIGURATION (PostgreSQL Read-Only)
# ==============================================================================
# Anda dapat memilih salah satu format:
# FORMAT 1: Komponen Terpisah (Host, Port, DB, User, Pass) -> Auto-assembled
# FORMAT 2: URL DSN Utuh (DB_*_URL)

# ------------------------------------------------------------------------------
# Database 1
# ------------------------------------------------------------------------------
DB_xxx_HOST="url.xxx"
DB_xxx_PORT="xxxx"
DB_xxx_NAME="xxx_dev"
DB_xxx_USER="qa_read_only"
DB_xxx_PASS="your_secure_password"


# ------------------------------------------------------------------------------
# Database 2
# ------------------------------------------------------------------------------
DB_xxxx_DEV_HOST="url.xxx"
DB_xxxx_DEV_PORT="xxxx"
DB_xxxx_DEV_NAME="xxx_dev"
DB_xxxx_DEV_USER="qa_read_only"
DB_xxxx_DEV_PASS="your_secure_password"

