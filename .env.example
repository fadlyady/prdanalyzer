# E2E test config for QA Browser Execution
E2E_ENV="staging"
E2E_BASE_URL_STAGING="https://staging.example.com"

# Format Kredensial Role:
# USER_<ROLE>_<IDENTIFIER>="username/email"
# PASS_<ROLE>_<IDENTIFIER>="password"
USER_OWNER_MAIN="user-owner@example.com"
PASS_OWNER_MAIN="your-password-here"
USER_CS_AGENT="cs-agent@example.com"
PASS_CS_AGENT="your-password-here"

# ==============================================================================
# DATABASE QA VALIDATION CONFIGURATION (PostgreSQL Read-Only)
# ==============================================================================
# Anda dapat memilih salah satu format:
# FORMAT 1: Komponen Terpisah (Host, Port, DB, User, Pass) -> Auto-assembled
# FORMAT 2: URL DSN Utuh (DB_*_URL)

# ------------------------------------------------------------------------------
# Database 1
# ------------------------------------------------------------------------------
DB_xxx_HOST="url.xxx"
DB_xxx_PORT="xxxx"
DB_xxx_NAME="xxx_dev"
DB_xxx_USER="qa_read_only"
DB_xxx_PASS="your_secure_password"


# ------------------------------------------------------------------------------
# Database 2
# ------------------------------------------------------------------------------
DB_xxxx_DEV_HOST="url.xxx"
DB_xxxx_DEV_PORT="xxxx"
DB_xxxx_DEV_NAME="xxx_dev"
DB_xxxx_DEV_USER="qa_read_only"
DB_xxxx_DEV_PASS="your_secure_password"


# ==============================================================================
# MOBILE QA EXECUTION (Android / Appium)
# ==============================================================================
MOBILE_APP_PACKAGE_STAGING=com.example.app.staging
MOBILE_APP_ACTIVITY=com.example.app.MainActivity
MOBILE_DEEPLINK_HOST=https://app.example.com
# ANDROID_DEVICE_SERIAL=
# APPIUM_URL=http://127.0.0.1:4723

# ==============================================================================
# MUTATION POLICY — Gate 4 browser-qa-guard & mobile-qa-guard (lihat mcp-server-browser-qa/src/policy.js)
# ==============================================================================
# Mode default setiap run (agent tidak bertanya ulang bila diset):
#   safe          = read-only, langkah mutasi -> PARTIAL TEST WITH REASON
#   full          = CREATE / UPDATE / DELETE / ubah status nyata di staging
#   full_external = full + kirim/balas/broadcast HANYA ke QA_TEST_RECIPIENT_ALLOWLIST
QA_MUTATION_MODE=safe
# Host staging yang boleh dibuka browser (koma; subdomain ikut). Host dari *_BASE_URL_STAGING otomatis masuk.
QA_STAGING_HOSTS=staging.example.com
# Host production — selalu ditolak (exact, atau *.domain untuk semua subdomain)
QA_PROD_HOSTS_DENY=app.example.com
# Penerima uji untuk mode full_external: nomor (08xx / 62xx / +62 …) atau nama kontak/daftar broadcast uji
QA_TEST_RECIPIENT_ALLOWLIST=
# Prefix TAG data uji (TAG run = <prefix>-yymmddHHMM). Data yang dibuat agent wajib memuat TAG ini.
QA_DATA_TAG_PREFIX=QAAUTO
# Kategori yang hanya boleh menyentuh data ber-TAG: "delete,update" (default) | "delete" | "off"
QA_REQUIRE_DATA_TAG=delete,update
# Jumlah langkah setelah membuka data ber-TAG di mana edit/hapus tetap diizinkan
QA_TAG_CONTEXT_WINDOW=6
# Aksi finansial (bayar/top up/checkout/potong kuota) — true HANYA bila staging memakai payment sandbox
QA_FINANCIAL_SANDBOX=false
# Mobile: izinkan mutasi via koordinat ber-anchor (relatif ke elemen ber-ID/label) di mode full
QA_ALLOW_ANCHORED_COORDINATE_MUTATION=true
