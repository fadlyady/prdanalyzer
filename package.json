{
  "name": "prdanalyzer",
  "version": "1.0.0",
  "description": "Repository ini dirancang untuk tim **Quality Assurance (QA), Product Manager (PM), dan Software Engineer (SWE)** guna mempercepat siklus analisis kebutuhan dan pengujian perangkat lunak di berbagai domain aplikasi (**Web SPA/SSR, Mobile Android/iOS, Backend REST/GraphQL/gRPC APIs, Microservices, Event-Driven/Webhooks, Data Pipelines, hingga IoT**).",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "npm --prefix mcp-server-browser-qa install",
    "mcp:start": "node mcp-server-browser-qa/src/index.js",
    "mcp:db:build": "cd mcp-server-database-qa && go build -o bin/postgres-mcp-go ./cmd/postgres-mcp-go",
    "mcp:db:everpro": "node mcp-server-database-qa/runner.js -target-db=everpro",
    "mcp:db:external": "node mcp-server-database-qa/runner.js -target-db=external",
    "mcp:db:docker:up": "docker compose -f mcp-server-database-qa/docker-compose.yml up -d --build",
    "mcp:db:docker:down": "docker compose -f mcp-server-database-qa/docker-compose.yml down",
    "mcp:db:docker:logs": "docker compose -f mcp-server-database-qa/docker-compose.yml logs -f",
    "db:validate": "node .agents/skills/database-qa-validation/scripts/db_validator.js",
    "db:inspect": "node .agents/skills/database-qa-validation/scripts/db_validator.js --mode=inspect",
    "db:assert": "node .agents/skills/database-qa-validation/scripts/db_validator.js --mode=assert",
    "db:handoff": "node .agents/skills/database-qa-validation/scripts/db_validator.js --handoff",
    "browser:list": "node scripts/browser_bridge.js list",
    "browser:inspect": "node scripts/browser_bridge.js inspect",
    "browser:screenshot": "node scripts/browser_bridge.js screenshot",
    "browser:test": "node scripts/browser_bridge.js run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadlyady/prdanalyzer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fadlyady/prdanalyzer/issues"
  },
  "homepage": "https://github.com/fadlyady/prdanalyzer#readme",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
