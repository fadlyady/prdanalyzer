# Salin ke .secrets/<ALIAS>.env (LOKAL, di-gitignore). Jangan pernah commit nilai asli.
E2E_ENV=staging
E2E_BASE_URL_STAGING=https://staging.example.com
USER_OWNER_1=user@example.com
PASS_OWNER_1=your-password-here
# MOBILE_APP_PACKAGE_STAGING=com.example.app.staging
# MOBILE_APP_ACTIVITY=com.example.app.MainActivity
# MOBILE_DEEPLINK_HOST=https://app.example.com
# QA_DEFAULT_MOBILE_ROLE=OWNER_1
QA_STAGING_HOSTS=staging.example.com
QA_PROD_HOSTS_DENY=app.example.com
QA_DATA_TAG_PREFIX=QAAUTO
# QA_MUTATION_MODE=safe
# QA_TEST_RECIPIENT_ALLOWLIST=
# DB alias db:main -> DB_MAIN_* (MCP target "primary"); db:external -> DB_EXTERNAL_DEV_*
# DB_MAIN_HOST=db.example.internal
# DB_MAIN_PORT=5432
# DB_MAIN_NAME=app_dev
# DB_MAIN_USER=qa_read_only
# DB_MAIN_PASS=your-password-here
