# ==============================================================================
# MCP DATABASE QA GATEWAY - DOCKER / ORBSTACK CREDENTIALS
# ==============================================================================
# PENTING:
# Salin file ini menjadi `.env.docker` di folder yang sama:
#   cp mcp-server-database-qa/.env.docker.example mcp-server-database-qa/.env.docker
#
# File `.env.docker` SUDAH DI-GITIGNORE sehingga kredensial TIDAK AKAN PERNAH
# ter-commit ke Git repo atau terbaca oleh AI Agent di workspace root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Inti / Primary -> Port 8081
# ------------------------------------------------------------------------------
# Format Opsi A: Komponen Terpisah (Mendukung DB_EVERPRO_* atau DB_PRIMARY_*)
DB_EVERPRO_HOST="staging-postgres.example.internal"
DB_EVERPRO_PORT="5432"
DB_EVERPRO_NAME="primary_dev"
DB_EVERPRO_USER="qa_read_only"
DB_EVERPRO_PASS="your_secure_password"

# Format Opsi B: URL DSN Utuh (Opsional, jika diisi akan menimpa opsi A)
# DB_EVERPRO_URL="postgres://qa_read_only:your_secure_password@staging-postgres.example.internal:5432/primary_dev?sslmode=disable"

# ------------------------------------------------------------------------------
# 2. Database Layanan Eksternal / Secondary -> Port 8082
# ------------------------------------------------------------------------------
# Format Opsi A: Komponen Terpisah (Mendukung DB_EXTERNAL_DEV_* atau DB_SECONDARY_*)
DB_EXTERNAL_DEV_HOST="staging-external-db.example.internal"
DB_EXTERNAL_DEV_PORT="5432"
DB_EXTERNAL_DEV_NAME="external_dev"
DB_EXTERNAL_DEV_USER="qa_read_only"
DB_EXTERNAL_DEV_PASS="your_secure_password"

# Format Opsi B: URL DSN Utuh (Opsional, jika diisi akan menimpa opsi A)
# DB_EXTERNAL_DEV_URL="postgres://qa_read_only:your_secure_password@staging-external-db.example.internal:5432/external_dev?sslmode=disable"
