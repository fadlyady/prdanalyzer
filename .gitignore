# Supplementary Test Data (ignore local datasets, preserve README and gitkeep)
automate-support/*
!automate-support/.gitkeep
!automate-support/README.md

# Ignore all files in strukturmenu and its subfolders, but keep structure & .gitkeep
strukturmenu/**
!strukturmenu/**/
!strukturmenu/**/.gitkeep

